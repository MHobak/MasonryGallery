@implements IAsyncDisposable
@inject GalleryService Gallery
@inject IJSRuntime JS
@inject WindowControl Window

<div class="lb @(_presenting ? "presenting" : null)" role="dialog" aria-modal="true" aria-label="Media viewer" tabindex="0" @ref="_root"
     @onkeydown="OnKey" @onkeydown:stopPropagation="true">
    <div class="lb-top">
        <div class="lb-title">
            <strong>@_item?.FileName</strong>
            @if (_item is not null)
            {
                <small>@Describe(_item)</small>
            }
        </div>
        <div class="lb-actions">
            @if (_item is not null)
            {
                <button type="button" class="icon-btn fav-btn" aria-pressed="@Bool(_item.Favorite)" aria-label="Favorite" title="Favorite (F)"
                        @onclick="ToggleFavorite">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7.5-4.6-7.5-10.3A4.2 4.2 0 0 1 12 7.2a4.2 4.2 0 0 1 7.5 2.5C19.5 15.4 12 20 12 20z"/></svg>
                </button>
                <button type="button" class="icon-btn" aria-pressed="@Bool(_info)" aria-label="Details" title="Details (I)"
                        @onclick="() => _info = !_info">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/></svg>
                </button>
                @if (IsPlayableVideo)
                {
                    <button type="button" class="icon-btn" aria-pressed="@Bool(Loop)" aria-label="Loop video" title="Loop video (R)"
                            @onclick="ToggleLoop">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 2l3 3-3 3M4 11V9a4 4 0 0 1 4-4h12M7 22l-3-3 3-3M20 13v2a4 4 0 0 1-4 4H4"/></svg>
                    </button>
                }
                <button type="button" class="icon-btn" aria-label="Presentation" title="Presentation, full screen (P). Autoplay: A"
                        @onclick="() => SetPresentingAsync(true)">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg>
                </button>
                <button type="button" class="icon-btn" aria-label="Open in default app" title="Open in default app (O)"
                        @onclick="() => OpenExternallyAsync(false)">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg>
                </button>
            }
            <button type="button" class="icon-btn" aria-label="Close" title="Close (Esc)" @onclick="CloseAsync">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
            </button>
        </div>
    </div>

    <div class="lb-body">
        @* A click on the blank area beside the media moves back or on (lightbox.js); nothing closes on a click. *@
        <div class="lb-stage" @ref="_stage">
            @if (_presenting)
            {
                <div class="present-bar">
                    <span class="present-count">@(_pos + 1) / @Ids.Length</span>
                    <button type="button" class="icon-btn" aria-pressed="@Bool(_autoplay)" aria-label="Autoplay"
                            title="@(_autoplay ? "Pause autoplay (A)" : "Autoplay (A)")" @onclick="ToggleAutoplay">
                        @if (_autoplay)
                        {
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14"/></svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5v14l11-7z"/></svg>
                        }
                    </button>
                    @if (IsPlayableVideo)
                    {
                        <button type="button" class="icon-btn" aria-pressed="@Bool(Loop)" aria-label="Loop video" title="Loop video (R)"
                                @onclick="ToggleLoop">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 2l3 3-3 3M4 11V9a4 4 0 0 1 4-4h12M7 22l-3-3 3-3M20 13v2a4 4 0 0 1-4 4H4"/></svg>
                        </button>
                    }
                    <button type="button" class="icon-btn" aria-label="Exit presentation" title="Exit presentation (Esc)"
                            @onclick="() => SetPresentingAsync(false)">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5"/></svg>
                    </button>
                </div>
                @if (_slideTimer is not null)
                {
                    @* Restarted per slide by @key (a string, so it never collides with the media element's ID key). *@
                    <div class="slide-progress" @key="@($"slide-{_slideKey}")" style="animation-duration: @(SlideSeconds)s" aria-hidden="true"></div>
                }
            }
            <button type="button" class="nav prev" aria-label="Previous" disabled="@(_pos <= 0)"
                    @onclick="() => GoAsync(-1)">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg>
            </button>

            @if (_item is not null)
            {
                @if (_item.Kind == MediaKind.Video)
                {
                    @if (_videoFailed || (_item.Playable == false && !_tryAnyway))
                    {
                        <div class="lb-fallback">
                            <p>@(_videoFailed ? "This video can't be played here." : "This video's format usually can't be played here.")</p>
                            <div class="row">
                                <button type="button" class="btn primary" @onclick="() => OpenExternallyAsync(false)">Open in default player</button>
                                @if (!_videoFailed)
                                {
                                    <button type="button" class="btn" @onclick="() => _tryAnyway = true">Try here anyway</button>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <video @key="_item.Id" src="@Gallery.GetMediaUrl(_item.Id)" controls autoplay playsinline loop="@Loop"
                               poster="@Gallery.GetThumbnailUrl(_item.Id, "medium")"
                               @onerror="OnVideoError" @onended="OnVideoEndedAsync"></video>
                    }
                }
                else
                {
                    @* Known dimensions size the box at once; the 960 px preview fills it until the original arrives. *@
                    <img @key="_item.Id" class="zoomable" src="@Gallery.GetMediaUrl(_item.Id)" alt="@_item.FileName"
                         width="@_item.Width" height="@_item.Height" draggable="false"
                         style="background-image: url('@Gallery.GetThumbnailUrl(_item.Id, "medium")')" />
                }
            }

            <button type="button" class="nav next" aria-label="Next" disabled="@(_pos >= Ids.Length - 1)"
                    @onclick="() => GoAsync(1)">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
            </button>
            @* Touch feedback ("« 10 s", "2× »"); lightbox.js fills it, so it stays empty here. *@
            <div class="lb-gesture" aria-hidden="true"></div>
        </div>

        @if (_info && _item is not null)
        {
            <aside class="lb-info" aria-label="Details">
                <dl>
                    <dt>Folder</dt>
                    <dd title="@Folder(_item)">@Folder(_item)</dd>
                    <dt>Library</dt>
                    <dd>@(Libraries.FirstOrDefault(l => l.Id == _item.LibraryId)?.Name ?? "—")</dd>
                    @if (_item.Width is > 0 && _item.Height is > 0)
                    {
                        <dt>Dimensions</dt>
                        <dd>@_item.Width × @_item.Height</dd>
                    }
                    @if (_item.DurationMs is > 0)
                    {
                        <dt>Duration</dt>
                        <dd>@FormatDuration(_item.DurationMs.Value)</dd>
                    }
                    <dt>Size</dt>
                    <dd>@FormatSize(_item.SizeBytes)</dd>
                    @if (_item.DateTaken is { } taken)
                    {
                        <dt>Taken</dt>
                        <dd>@taken.ToLocalTime().ToString("d MMM yyyy, HH:mm")</dd>
                    }
                    <dt>Added</dt>
                    <dd>@_item.DateAdded.ToLocalTime().ToString("d MMM yyyy")</dd>
                    @if (_sidecar is { } x)
                    {
                        @if (x.Title is not null)
                        {
                            <dt>Title</dt>
                            <dd>@x.Title</dd>
                        }
                        @if (x.Creator is not null)
                        {
                            <dt>Creator</dt>
                            <dd>@x.Creator</dd>
                        }
                        @if (x.Rating is { } stars)
                        {
                            <dt>Rating</dt>
                            <dd aria-label="@stars out of 5">@(new string('★', stars))@(new string('☆', 5 - stars))</dd>
                        }
                        @if (x.Source is not null)
                        {
                            <dt>Source</dt>
                            <dd>
                                @if (IsWebLink(x.Source))
                                {
                                    <button type="button" class="link" title="@x.Source" @onclick="() => OpenLink(x.Source)">@Host(x.Source)</button>
                                }
                                else
                                {
                                    <span title="@x.Source">@x.Source</span>
                                }
                            </dd>
                        }
                    }
                </dl>
                @if (_sidecar?.Description is { } description)
                {
                    <p class="lb-description">@description</p>
                }

                @foreach (var group in SidecarTagGroups)
                {
                    <h3>@group.Key</h3>
                    <div class="tag-list">
                        @foreach (var tag in group)
                        {
                            <button type="button" class="tag-chip link-chip" title="Show items tagged @tag.Name" @onclick="() => OnTagClicked.InvokeAsync(tag.Name)">@tag.Name</button>
                        }
                    </div>
                }

                <h3>@(_tags.Any(t => t.FromSidecar) ? "Your tags" : "Tags")</h3>
                <div class="tag-list">
                    @foreach (var tag in _tags.Where(t => !t.FromSidecar))
                    {
                        <span class="tag-chip">
                            <button type="button" class="name" title="Show items tagged @tag.Name" @onclick="() => OnTagClicked.InvokeAsync(tag.Name)">@tag.Name</button>
                            <button type="button" aria-label="Remove tag @tag.Name" @onclick="() => RemoveTagAsync(tag.Name)">×</button>
                        </span>
                    }
                </div>
                @* Keys typed here must not drive the viewer (F, I, arrows...). *@
                <input type="text" class="tag-input" list="lb-tag-suggestions" placeholder="Add a tag and press Enter" aria-label="Add tag"
                       @bind="_newTag" @bind:event="oninput" @bind:after="SuggestAsync" @onkeydown="OnTagKeyAsync" @onkeydown:stopPropagation="true" />
                <datalist id="lb-tag-suggestions">
                    @foreach (var t in _suggestions)
                    {
                        <option value="@t.Name"></option>
                    }
                </datalist>

                <button type="button" class="btn" @onclick="() => OpenExternallyAsync(true)">Show in folder</button>
            </aside>
        }
    </div>

    @* Neighbours load in the background so arrowing through is instant. *@
    <div hidden aria-hidden="true">
        @foreach (var n in _neighbors)
        {
            <img src="@(n.Kind == MediaKind.Image ? Gallery.GetMediaUrl(n.Id) : Gallery.GetThumbnailUrl(n.Id, "medium"))" alt="" />
        }
    </div>

    @if (_error is not null)
    {
        <div class="lb-toast" role="alert">@_error</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public int[] Ids { get; set; } = [];
    [Parameter, EditorRequired] public int CurrentId { get; set; }
    [Parameter] public IReadOnlyList<Library> Libraries { get; set; } = [];
    /// <summary>Open straight into presentation mode (full screen, chrome hidden).</summary>
    [Parameter] public bool Present { get; set; }
    /// <summary>With <see cref="Present"/>: start with autoplay on.</summary>
    [Parameter] public bool Autoplay { get; set; }

    private const int SeekSeconds = 5;

    // Loop is a viewing preference: on by default and remembered while the app runs. Presentation keeps its own
    // switch, off at every start, so a looping video doesn't hold up autoplay unless asked to.
    private static bool _loopInViewer = true;
    private bool _loopInPresentation;
    private bool _autoplay;
    private CancellationTokenSource? _slideTimer;
    private int _slideKey;

    private bool Loop => _presenting ? _loopInPresentation : _loopInViewer;
    private bool IsPlayableVideo => _item?.Kind == MediaKind.Video && !_videoFailed && (_item.Playable != false || _tryAnyway);
    private int SlideSeconds => Gallery.GetSettings().SlideshowSeconds;
    /// <summary>A tag was clicked: the gallery filters by it (and closes the viewer).</summary>
    [Parameter] public EventCallback<string> OnTagClicked { get; set; }
    /// <summary>Receives the item shown last, so the grid can scroll to it.</summary>
    [Parameter] public EventCallback<int> OnClose { get; set; }
    [Parameter] public EventCallback<(int Id, bool Favorite)> OnFavoriteChanged { get; set; }
    [Parameter] public EventCallback OnTagsChanged { get; set; }

    private ElementReference _root, _stage;
    private IJSObjectReference? _module, _zoom, _presentation;
    private DotNetObjectReference<Lightbox>? _self;
    private bool _presenting;
    private MediaItem? _item;
    private IReadOnlyList<Tag> _tags = [];
    private IReadOnlyList<TagCount> _suggestions = [];
    private SidecarData? _sidecar;
    private IReadOnlyList<MediaItem> _neighbors = [];
    private string _newTag = "";
    private string? _error;
    private int _pos, _loadedId = -1;
    private bool _focus = true, _info, _videoFailed, _tryAnyway;
    private CancellationTokenSource? _errorTimer;

    protected override async Task OnParametersSetAsync()
    {
        if (CurrentId == _loadedId) return;
        await LoadAsync(CurrentId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/MasonryGallery.UI/js/lightbox.js");
            _self = DotNetObjectReference.Create(this);
            _zoom = await _module.InvokeAsync<IJSObjectReference>("create", _stage, _self);
            if (Present)
            {
                _autoplay = Autoplay;
                await SetPresentingAsync(true);
                StateHasChanged();
            }
        }
        if (!_focus) return;
        _focus = false;
        await _root.FocusAsync();
    }

    private async Task LoadAsync(int id)
    {
        _loadedId = id;
        _pos = Array.IndexOf(Ids, id);
        _item = await Gallery.GetMediaAsync(id);
        _tags = _item is null ? [] : await Gallery.GetTagsAsync(id);
        _sidecar = _item?.SidecarPath is null ? null : await Gallery.GetSidecarAsync(id);
        _videoFailed = _tryAnyway = false;
        _newTag = "";
        if (_zoom is not null) await _zoom.InvokeVoidAsync("reset");

        var neighbors = new List<MediaItem>(2);
        foreach (var p in new[] { _pos + 1, _pos - 1 })
        {
            if (p >= 0 && p < Ids.Length && await Gallery.GetMediaAsync(Ids[p]) is { } n)
                neighbors.Add(n);
        }
        _neighbors = neighbors;
        ScheduleSlide();
    }

    private async Task GoAsync(int delta)
    {
        var next = _pos + delta;
        if (next < 0 || next >= Ids.Length) return;
        await LoadAsync(Ids[next]);
    }

    // ── Autoplay and video controls ──

    private void ToggleAutoplay()
    {
        _autoplay = !_autoplay;
        ScheduleSlide();
    }

    private void ToggleLoop()
    {
        if (_presenting) _loopInPresentation = !_loopInPresentation;
        else _loopInViewer = !_loopInViewer;
        ScheduleSlide(); // a video that stops looping can end and move on, and vice versa
    }

    /// <summary>
    /// Sets up the move to the next item: images (and videos that can't play) after the slideshow time;
    /// playable videos when they end (<see cref="OnVideoEndedAsync"/>), never while looping.
    /// Called after every change of item, so manual navigation restarts the countdown.
    /// </summary>
    private void ScheduleSlide()
    {
        _slideTimer?.Cancel();
        _slideTimer = null;
        if (!_autoplay || !_presenting || _item is null || IsPlayableVideo)
            return;

        var timer = _slideTimer = new CancellationTokenSource();
        _slideKey++;
        _ = Task.Delay(TimeSpan.FromSeconds(SlideSeconds), timer.Token).ContinueWith(t =>
        {
            if (!t.IsCanceled) _ = InvokeAsync(async () => { await AdvanceAsync(); StateHasChanged(); });
        }, TaskScheduler.Default);
    }

    // Autoplay wraps around at the end; manual arrows stop at the ends.
    private async Task AdvanceAsync()
    {
        if (!_autoplay || !_presenting || Ids.Length == 0) return;
        await LoadAsync(Ids[(_pos + 1) % Ids.Length]);
    }

    private async Task OnVideoEndedAsync()
    {
        if (_autoplay && _presenting && !Loop)
            await AdvanceAsync();
    }

    private void OnVideoError()
    {
        _videoFailed = true;
        ScheduleSlide(); // now shown as a still: give it the image time
    }

    private async Task VideoAsync(string method, params object[] args)
    {
        if (_zoom is not null && IsPlayableVideo) await _zoom.InvokeVoidAsync(method, args);
    }

    private Task CloseAsync() => OnClose.InvokeAsync(_loadedId);

    /// <summary>
    /// A touch swipe, or ("next" / "prev") a click beside the media, on the stage (lightbox.js).
    /// Returns whether the item changed; if not, swiped media snaps back.
    /// </summary>
    [JSInvokable]
    public async Task<bool> OnSwipe(string action)
    {
        switch (action)
        {
            case "next" or "prev":
                var from = _pos;
                await GoAsync(action == "next" ? 1 : -1);
                StateHasChanged();
                return _pos != from;
            case "close" when _presenting:
                await SetPresentingAsync(false); // like Esc: leave presentation first
                break;
            case "close":
                await CloseAsync();
                return true;
            case "details" when !_presenting: // presentation hides the details panel
                _info = !_info;
                break;
        }
        StateHasChanged();
        return false;
    }


    // Full screen window, no chrome, media scaled up to fill the screen without cropping (see .presenting in app.css).
    private async Task SetPresentingAsync(bool on)
    {
        if (on == _presenting) return;
        _presenting = on;
        if (on) _loopInPresentation = false; // each presentation starts with videos playing through
        else _autoplay = false;
        Window.SetFullScreen?.Invoke(on);
        if (_zoom is not null) await _zoom.InvokeVoidAsync("reset");
        if (on && _module is not null)
        {
            _presentation = await _module.InvokeAsync<IJSObjectReference>("present", _root);
        }
        else if (!on && _presentation is not null)
        {
            await _presentation.InvokeVoidAsync("dispose");
            await _presentation.DisposeAsync();
            _presentation = null;
        }
        _focus = true; // the exit button may have had focus; keys must keep reaching the viewer
        ScheduleSlide();
    }

    private async Task ToggleFavorite()
    {
        if (_item is null) return;
        _item.Favorite = !_item.Favorite;
        await Gallery.SetFavoriteAsync(_item.Id, _item.Favorite);
        await OnFavoriteChanged.InvokeAsync((_item.Id, _item.Favorite));
    }

    private async Task OnTagKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_newTag) && _item is not null)
        {
            var tag = _newTag.Trim();
            _newTag = "";
            if (_tags.Any(t => string.Equals(t.Name, tag, StringComparison.OrdinalIgnoreCase))) return;
            await SaveTagsAsync([.. UserTags, tag]);
        }
        else if (e.Key == "Escape")
        {
            await _root.FocusAsync();
        }
    }

    private Task RemoveTagAsync(string tag)
        => SaveTagsAsync(UserTags.Where(t => !string.Equals(t, tag, StringComparison.OrdinalIgnoreCase)).ToList());

    private IEnumerable<string> UserTags => _tags.Where(t => !t.FromSidecar).Select(t => t.Name);

    // Categories as the sidecar names them (Artist, Character...), alphabetical; plain keywords last.
    private IEnumerable<IGrouping<string, Tag>> SidecarTagGroups => _tags
        .Where(t => t.FromSidecar)
        .GroupBy(t => t.Category ?? "")
        .OrderBy(g => g.Key.Length == 0)
        .ThenBy(g => g.Key, StringComparer.OrdinalIgnoreCase)
        .Select(g => g.Key.Length > 0 ? g : new Grouping("Keywords", g));

    private sealed class Grouping(string key, IEnumerable<Tag> tags) : IGrouping<string, Tag>
    {
        public string Key => key;
        public IEnumerator<Tag> GetEnumerator() => tags.GetEnumerator();
        System.Collections.IEnumerator System.Collections.IEnumerable.GetEnumerator() => GetEnumerator();
    }

    private async Task SuggestAsync()
        => _suggestions = _newTag.Trim().Length == 0 ? [] : await Gallery.SearchTagsAsync(_newTag, 8);

    private static bool IsWebLink(string url)
        => Uri.TryCreate(url, UriKind.Absolute, out var uri) && (uri.Scheme == Uri.UriSchemeHttps || uri.Scheme == Uri.UriSchemeHttp);

    private static string Host(string url) => new Uri(url).Host;

    private async Task OpenLink(string url)
    {
        var result = Gallery.OpenLink(url);
        if (!result.IsSuccess) await ShowErrorAsync(result.Error!);
    }

    private async Task SaveTagsAsync(IReadOnlyList<string> tags)
    {
        if (_item is null) return;
        await Gallery.SetTagsAsync(_item.Id, tags);
        _tags = await Gallery.GetTagsAsync(_item.Id);
        await OnTagsChanged.InvokeAsync();
    }

    private async Task OpenExternallyAsync(bool showFolder)
    {
        if (_item is null) return;
        var result = await Gallery.OpenExternallyAsync(_item.Id, showFolder);
        if (!result.IsSuccess) await ShowErrorAsync(result.Error!);
    }

    private async Task ShowErrorAsync(string message)
    {
        _errorTimer?.Cancel();
        _errorTimer = new CancellationTokenSource();
        var token = _errorTimer.Token;
        _error = message;
        StateHasChanged();
        try
        {
            await Task.Delay(4000, token);
            _error = null;
        }
        catch (TaskCanceledException) { }
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.CtrlKey || e.AltKey || e.MetaKey) return; // leave Ctrl+R, Alt+Left and the like alone
        switch (e.Key)
        {
            case "Escape" when _presenting: await SetPresentingAsync(false); break;
            case "Escape": await CloseAsync(); break;
            case "p" or "P" or "F11": await SetPresentingAsync(!_presenting); break;
            case "a" or "A" when _presenting: ToggleAutoplay(); break;
            case "a" or "A": _autoplay = true; await SetPresentingAsync(true); break;
            case "r" or "R": ToggleLoop(); break;
            case "k" or "K": await VideoAsync("togglePlay"); break;
            case "j" or "J": await VideoAsync("seek", -SeekSeconds); break;
            case "l" or "L": await VideoAsync("seek", SeekSeconds); break;
            case "ArrowLeft" when e.ShiftKey: await VideoAsync("seek", -SeekSeconds); break;
            case "ArrowRight" when e.ShiftKey: await VideoAsync("seek", SeekSeconds); break;
            case "ArrowLeft": await GoAsync(-1); break;
            case "ArrowRight": await GoAsync(1); break;
            case "f" or "F": await ToggleFavorite(); break;
            case "i" or "I": _info = !_info; break;
            case "o" or "O": await OpenExternallyAsync(false); break;
            case "+" or "=": if (_zoom is not null) await _zoom.InvokeVoidAsync("zoomIn"); break;
            case "-": if (_zoom is not null) await _zoom.InvokeVoidAsync("zoomOut"); break;
            case "0": if (_zoom is not null) await _zoom.InvokeVoidAsync("reset"); break;
        }
    }

    private static string Folder(MediaItem m)
    {
        var dir = Path.GetDirectoryName(m.RelPath)?.Replace('\\', '/');
        return string.IsNullOrEmpty(dir) ? "/" : dir;
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1 << 30 => $"{bytes / 1073741824.0:0.#} GB",
        >= 1 << 20 => $"{bytes / 1048576.0:0.#} MB",
        >= 1 << 10 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes} B"
    };

    private static string FormatDuration(long ms)
        => TimeSpan.FromMilliseconds(ms).ToString(ms >= 3_600_000 ? @"h\:mm\:ss" : @"m\:ss");

    private static string Describe(MediaItem m)
    {
        var parts = new List<string>();
        if (m.Width is > 0 && m.Height is > 0) parts.Add($"{m.Width}×{m.Height}");
        if (m.DurationMs is > 0) parts.Add(FormatDuration(m.DurationMs.Value));
        parts.Add(FormatSize(m.SizeBytes));
        if (m.DateTaken is { } d) parts.Add(d.ToLocalTime().ToString("d MMM yyyy"));
        return string.Join(" · ", parts);
    }

    public async ValueTask DisposeAsync()
    {
        _errorTimer?.Cancel();
        _slideTimer?.Cancel();
        // Closing the viewer from presentation (e.g. the item was deleted) must not leave the window full screen.
        if (_presenting) Window.SetFullScreen?.Invoke(false);
        try
        {
            if (_presentation is not null)
            {
                await _presentation.InvokeVoidAsync("dispose");
                await _presentation.DisposeAsync();
            }
            if (_zoom is not null)
            {
                await _zoom.InvokeVoidAsync("dispose");
                await _zoom.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        _self?.Dispose();
    }
}
