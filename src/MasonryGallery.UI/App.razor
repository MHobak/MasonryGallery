@implements IAsyncDisposable
@inject GalleryService Gallery
@inject IJSRuntime JS
@inject AppMode Mode
@inject WindowControl Window

<div class="app">
    <header class="bar">
        <h1 class="brand">Masonry<span>Gallery</span></h1>

        <div class="tools">
            <label class="search">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                <input type="search" placeholder="Search names and folders" aria-label="Search file names and folders" value="@_filter.Search" @oninput="OnSearch" />
            </label>

            <div class="chips" role="group" aria-label="Filter by type">
                <button type="button" class="chip" aria-pressed="@Bool(_filter.Kind is null)" @onclick="() => ApplyAsync(_filter with { Kind = null })">All</button>
                <button type="button" class="chip" aria-pressed="@Bool(_filter.Kind == MediaKind.Image)" @onclick="() => ApplyAsync(_filter with { Kind = MediaKind.Image })">Photos</button>
                <button type="button" class="chip" aria-pressed="@Bool(_filter.Kind == MediaKind.Video)" @onclick="() => ApplyAsync(_filter with { Kind = MediaKind.Video })">Videos</button>
                <button type="button" class="chip icon-chip" aria-pressed="@Bool(_filter.FavoritesOnly)" aria-label="Favorites only" title="Favorites only"
                        @onclick="() => ApplyAsync(_filter with { FavoritesOnly = !_filter.FavoritesOnly })">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7.5-4.6-7.5-10.3A4.2 4.2 0 0 1 12 7.2a4.2 4.2 0 0 1 7.5 2.5C19.5 15.4 12 20 12 20z"/></svg>
                </button>
            </div>

            <button type="button" class="chip" aria-expanded="@Bool(_filtersOpen)" aria-controls="filter-bar" @onclick="() => _filtersOpen = !_filtersOpen">
                Filters@(ExtraFilterCount > 0 ? $" · {ExtraFilterCount}" : "")
            </button>
        </div>

        <button type="button" class="icon-btn" aria-label="Start slideshow" title="Slideshow from the first item, autoplay on (P on a tile presents from there)"
                disabled="@(_count == 0)" @onclick="StartSlideshow">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5v14l11-7z"/></svg>
        </button>
        @if (Window.OpenNewWindow is not null)
        {
            <button type="button" class="icon-btn" aria-label="New window" title="New window (Ctrl+N): another view with its own filters"
                    @onclick="NewWindow">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="13" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-3"/></svg>
            </button>
        }
        @if (!Mode.IsViewer)
        {
        <button type="button" class="icon-btn" aria-label="Settings" title="Settings" @onclick="() => _settings = true">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>
        </button>
        <button type="button" class="icon-btn" aria-label="Libraries" title="Libraries" @onclick="() => _panel = true">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
        </button>
        }
        else
        {
            <span class="viewer-badge" title="Scanning, libraries and settings are managed in the main window">Viewer</span>
        }
    </header>

    @* Active tag filters keep the bar open: hiding them would leave a filtered grid with no visible reason. *@
    @if (_filtersOpen || TagFilterCount > 0)
    {
        <div class="filter-bar" id="filter-bar">
            <TagFilter Included="_filter.Tags ?? []" Excluded="_filter.ExcludedTags ?? []" OnChanged="OnTagFilterAsync" />
            <label>Sort
                <select class="select" @onchange="e => SortAsync(Enum.Parse<MediaSort>((string)e.Value!))">
                    <option value="@MediaSort.NewestFirst" selected="@(_filter.Sort == MediaSort.NewestFirst)">Newest first</option>
                    <option value="@MediaSort.OldestFirst" selected="@(_filter.Sort == MediaSort.OldestFirst)">Oldest first</option>
                    <option value="@MediaSort.RecentlyAdded" selected="@(_filter.Sort == MediaSort.RecentlyAdded)">Recently added</option>
                    <option value="@MediaSort.Name" selected="@(_filter.Sort == MediaSort.Name)">Name</option>
                    <option value="@MediaSort.Random" selected="@(_filter.Sort == MediaSort.Random)">Random</option>
                </select>
            </label>
            @if (_filter.Sort == MediaSort.Random)
            {
                <button type="button" class="btn" title="Shuffle again" @onclick="() => SortAsync(MediaSort.Random)">Shuffle</button>
            }
            @if (_libraries.Count > 1)
            {
                <label>Library
                    <select class="select" @onchange="OnLibrary">
                        <option value="" selected="@(_filter.LibraryId is null)">All libraries</option>
                        @foreach (var l in _libraries.Where(l => l.Enabled))
                        {
                            <option value="@l.Id.Value" selected="@(_filter.LibraryId == l.Id)">@l.Name</option>
                        }
                    </select>
                </label>
            }
            <label>From <input type="date" class="select" @bind="_from" @bind:after="OnDatesAsync" /></label>
            <label>To <input type="date" class="select" @bind="_to" @bind:after="OnDatesAsync" /></label>
            @if (ExtraFilterCount > 0 || _filter.Search is not null || _filter.Kind is not null || _filter.FavoritesOnly)
            {
                <button type="button" class="btn" @onclick="ClearFiltersAsync">Clear all</button>
            }
        </div>
    }

    <main class="stage">
        <div class="masonry" @ref="_host" aria-label="Media gallery"></div>

        @if (_loaded && _count == 0)
        {
            <div class="empty">
                @if (_libraries.Count == 0)
                {
                    <h2>Your gallery is empty</h2>
                    <p>Add a folder with photos and videos to get started.</p>
                    @if (Mode.IsViewer)
                    {
                        <p class="hint">Add libraries in the main window.</p>
                    }
                    else
                    {
                        <button type="button" class="btn primary" @onclick="() => _panel = true">Add a library</button>
                    }
                }
                else if (_filter != Unfiltered)
                {
                    <h2>Nothing matches</h2>
                    <p>Try another search, or clear the filters.</p>
                    <button type="button" class="btn" @onclick="ClearFiltersAsync">Clear filters</button>
                }
                else if (Gallery.IsBusy)
                {
                    <h2>Indexing your files…</h2>
                    <p>Items appear here as soon as they are found.</p>
                }
                else
                {
                    <h2>No photos or videos found</h2>
                    <p>Your libraries are empty, hidden or offline.</p>
                    @if (!Mode.IsViewer)
                    {
                        <button type="button" class="btn" @onclick="() => _panel = true">Open libraries</button>
                    }
                }
            </div>
        }
    </main>

    @if (_status is not null || _count > 0 || Offline > 0 || Polled > 0 || _failedCount > 0)
    {
        <footer class="status" aria-live="polite">
            @if (_status is { } st)
            {
                <span class="msg">@st.Message@(st.Total > 0 ? $"  {st.Completed:N0} / {st.Total:N0}" : "")</span>
                @if (!st.Message.StartsWith("Scan failed"))
                {
                    <span class="meter @(st.Total == 0 ? "busy" : "")"><i style="width:@(st.Total > 0 ? st.Completed * 100 / st.Total : 100)%"></i></span>
                }
            }
            @if (Offline > 0)
            {
                <button type="button" class="warn" disabled="@Mode.IsViewer" @onclick="() => _panel = true">@Offline @(Offline == 1 ? "library is" : "libraries are") offline</button>
            }
            @if (Polled > 0)
            {
                <button type="button" class="warn" disabled="@Mode.IsViewer" title="Live watching isn't available; changes show up within a few minutes"
                        @onclick="() => _panel = true">@Polled @(Polled == 1 ? "library isn't" : "libraries aren't") watched live</button>
            }
            @if (_failedCount > 0)
            {
                <button type="button" class="warn" disabled="@Mode.IsViewer" @onclick="() => _panel = true">@_failedCount.ToString("N0") @(_failedCount == 1 ? "file" : "files") couldn't be read</button>
            }
            <span class="count">@_count.ToString("N0") @(_count == 1 ? "item" : "items")</span>
        </footer>
    }

    @if (_panel && !Mode.IsViewer)
    {
        <LibraryPanel Libraries="_libraries" WatchStatuses="Gallery.WatchStatuses" Busy="@Gallery.IsBusy" OnClose="() => _panel = false"
                      OnAdded="OnLibraryAdded" OnRescan="Gallery.RequestScan" OnChanged="OnLibrariesChangedAsync" />
    }

    @if (_settings && !Mode.IsViewer)
    {
        <SettingsPanel OnClose="() => _settings = false" />
    }

    @if (_open is { } id)
    {
        <Lightbox Ids="_ids" CurrentId="id" Libraries="_libraries" Present="_present" Autoplay="_autoplay"
                  OnClose="CloseLightboxAsync" OnFavoriteChanged="OnFavoriteChangedAsync" OnTagClicked="FilterByTagAsync" />
    }
</div>

@code {
    private static readonly MediaFilter Unfiltered = new();
    private static readonly TimeSpan MinRefreshInterval = TimeSpan.FromMilliseconds(1500);

    private ElementReference _host;
    private IJSObjectReference? _module;
    private IJSObjectReference? _view;
    private DotNetObjectReference<App>? _self;
    private IReadOnlyList<Library> _libraries = [];
    private MediaFilter _filter = Unfiltered;
    private DateOnly? _from, _to;
    private int[] _ids = [];
    private int _count, _failedCount;
    private bool _loaded, _panel, _settings, _filtersOpen, _disposed;
    private bool _refreshing, _refreshPending, _pendingKeepPosition = true, _refreshQueued, _staleAfterLightbox;
    private int? _open;
    private bool _present, _autoplay;
    private PipelineEvent? _status;
    private DateTime _lastRefresh;
    private CancellationTokenSource? _searchDelay, _failureDelay;

    private int Offline => _libraries.Count(l => l.Enabled && l.Status == LibraryStatus.Offline);
    private int Polled => Gallery.WatchStatuses.Values.Count(s => s.Mode == WatchMode.Polling);

    private int ExtraFilterCount =>
        (_filter.Sort != MediaSort.NewestFirst ? 1 : 0) + (_filter.LibraryId is not null ? 1 : 0)
        + TagFilterCount + (_filter.From is not null ? 1 : 0) + (_filter.To is not null ? 1 : 0);

    private int TagFilterCount => (_filter.Tags?.Count ?? 0) + (_filter.ExcludedTags?.Count ?? 0);

    protected override void OnInitialized()
    {
        Gallery.ProgressChanged += OnProgress;
        Gallery.GalleryChanged += OnGalleryChanged;
        Gallery.ScanCompleted += OnScanCompleted;
        Gallery.BusyChanged += OnBusyChanged;
        Gallery.WatchStatusChanged += OnWatchStatusChanged;
        // The host starts the startup scans before the window shows.
        if (Gallery.IsBusy) _status = new PipelineEvent("Indexing files", 0, 0);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _self = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/MasonryGallery.UI/js/layout.js");
        _view = await _module.InvokeAsync<IJSObjectReference>("create", _host, _self, Gallery.Endpoint.BaseUrl, Gallery.Endpoint.Token);

        _libraries = await Gallery.GetLibrariesAsync();
        _failedCount = await Gallery.CountFailedAsync();
        await RefreshAsync(keepPosition: false);
    }

    /// <summary>Reloads the layout. Calls made while one is running are coalesced into one more pass, never dropped.</summary>
    private async Task RefreshAsync(bool keepPosition)
    {
        if (_view is null || _disposed) return;
        if (_refreshing)
        {
            _refreshPending = true;
            _pendingKeepPosition &= keepPosition;
            return;
        }

        _refreshing = true;
        try
        {
            do
            {
                _refreshPending = false;
                var flat = await Gallery.GetLayoutAsync(_filter);
                _count = flat.Length / GalleryService.LayoutStride;
                _ids = new int[_count];
                for (var i = 0; i < _count; i++) _ids[i] = flat[i * GalleryService.LayoutStride];
                await _view.InvokeVoidAsync("setItems", flat, keepPosition);
                _loaded = true;
                _lastRefresh = DateTime.UtcNow;
                StateHasChanged();
                keepPosition = _pendingKeepPosition;
                _pendingKeepPosition = true;
            } while (_refreshPending && !_disposed);
        }
        finally { _refreshing = false; }
    }

    // Scans report item changes every ~500 ms; refetching 100k rows that often would swamp the UI.
    private async Task QueueRefreshAsync()
    {
        if (_refreshQueued) return;
        _refreshQueued = true;
        var wait = MinRefreshInterval - (DateTime.UtcNow - _lastRefresh);
        if (wait > TimeSpan.Zero) await Task.Delay(wait);
        _refreshQueued = false;
        await RefreshAsync(keepPosition: true);
    }

    // Scans are started by the library monitor (startup, watcher, schedule) and by Rescan; this only shows results.
    private void OnScanCompleted(object? sender, ScanCompleted done)
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            _libraries = await Gallery.GetLibrariesAsync();
            _failedCount = await Gallery.CountFailedAsync();
            if (!done.Result.IsSuccess && done.Result.Error != "Cancelled")
                await ShowFailureAsync(done.Result.Error!);
            else
                StateHasChanged();
        });
    }

    private async Task ShowFailureAsync(string error)
    {
        _failureDelay?.Cancel();
        _failureDelay = new CancellationTokenSource();
        var token = _failureDelay.Token;
        _status = new PipelineEvent($"Scan failed: {error}", 0, 0);
        StateHasChanged();
        try
        {
            await Task.Delay(6000, token);
            _status = Gallery.IsBusy ? new PipelineEvent("Indexing files", 0, 0) : null;
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private void OnBusyChanged(object? sender, EventArgs e)
    {
        if (_disposed) return;
        _ = InvokeAsync(() =>
        {
            var showingFailure = _status?.Message.StartsWith("Scan failed") == true;
            if (!Gallery.IsBusy && !showingFailure) _status = null;
            else if (Gallery.IsBusy && _status is null) _status = new PipelineEvent("Indexing files", 0, 0);
            StateHasChanged();
        });
    }

    private void OnWatchStatusChanged(object? sender, EventArgs e)
    {
        if (!_disposed) _ = InvokeAsync(StateHasChanged);
    }

    private void OnProgress(object? sender, PipelineEvent evt)
    {
        if (_disposed || evt.Message == "Up to date") return;
        _ = InvokeAsync(() =>
        {
            if (_status?.Message.StartsWith("Scan failed") == true) return;
            _status = evt;
            StateHasChanged();
        });
    }

    private void OnGalleryChanged(object? sender, GalleryChange change)
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            // Finished thumbnails go straight into their tiles; only new or resized items need a new layout.
            if (change.ReadyThumbnails.Length > 0 && _view is not null)
                await _view.InvokeVoidAsync("markReady", change.ReadyThumbnails);
            if (change.ItemsChanged)
            {
                // A viewer hears about the main window's work only through the database; library status
                // (offline, scanning) may have changed with it.
                if (Mode.IsViewer) _libraries = await Gallery.GetLibrariesAsync();
                await QueueRefreshAsync();
            }
        });
    }

    private async Task ApplyAsync(MediaFilter filter)
    {
        if (filter == _filter) return;
        _filter = filter;
        await RefreshAsync(keepPosition: false);
    }

    // Random gets a fresh seed every time it's picked; the same seed keeps the order while the view refreshes.
    private Task SortAsync(MediaSort sort)
        => ApplyAsync(_filter with { Sort = sort, Seed = sort == MediaSort.Random ? Random.Shared.Next() : 0 });

    private Task OnLibrary(ChangeEventArgs e)
        => ApplyAsync(_filter with { LibraryId = int.TryParse(e.Value?.ToString(), out var v) ? new LibraryId(v) : null });

    // Inclusive local calendar days, stored as UTC instants.
    private Task OnDatesAsync() => ApplyAsync(_filter with
    {
        From = _from?.ToDateTime(TimeOnly.MinValue, DateTimeKind.Local).ToUniversalTime(),
        To = _to?.ToDateTime(TimeOnly.MaxValue, DateTimeKind.Local).ToUniversalTime()
    });

    private Task ClearFiltersAsync()
    {
        _from = _to = null;
        return ApplyAsync(Unfiltered);
    }

    private async Task OnSearch(ChangeEventArgs e)
    {
        _searchDelay?.Cancel();
        _searchDelay = new CancellationTokenSource();
        var token = _searchDelay.Token;
        var text = e.Value?.ToString();
        try
        {
            await Task.Delay(250, token);
            await ApplyAsync(_filter with { Search = string.IsNullOrWhiteSpace(text) ? null : text });
        }
        catch (TaskCanceledException) { }
    }

    private Task OnTagFilterAsync((IReadOnlyList<string> Included, IReadOnlyList<string> Excluded) tags)
        => ApplyAsync(_filter with
        {
            Tags = tags.Included.Count > 0 ? tags.Included : null,
            ExcludedTags = tags.Excluded.Count > 0 ? tags.Excluded : null,
        });

    // A tag clicked in the viewer: show everything else that carries it.
    private async Task FilterByTagAsync(string tag)
    {
        _open = null;
        if (_filter.Tags?.Contains(tag, StringComparer.OrdinalIgnoreCase) == true)
            return;
        await ApplyAsync(_filter with
        {
            Tags = [.. _filter.Tags ?? [], tag],
            ExcludedTags = _filter.ExcludedTags?.Where(t => !string.Equals(t, tag, StringComparison.OrdinalIgnoreCase)).ToList() is { Count: > 0 } rest ? rest : null,
        });
    }

    private async Task OnLibraryAdded(Library lib)
    {
        _libraries = await Gallery.GetLibrariesAsync();
        await Gallery.LibrariesChangedAsync(); // the monitor scans and starts watching it
    }

    private async Task OnLibrariesChangedAsync()
    {
        await Gallery.LibrariesChangedAsync();
        _libraries = await Gallery.GetLibrariesAsync();
        _failedCount = await Gallery.CountFailedAsync();
        if (_filter.LibraryId is { } selected && !_libraries.Any(l => l.Id == selected && l.Enabled))
            _filter = _filter with { LibraryId = null };
        await RefreshAsync(keepPosition: true);
    }

    private async Task OnFavoriteChangedAsync((int Id, bool Favorite) change)
    {
        if (_view is not null) await _view.InvokeVoidAsync("setFavorite", change.Id, change.Favorite);
        // Don't pull the item out from under the open viewer; re-filter when it closes.
        if (_filter.FavoritesOnly) _staleAfterLightbox = true;
    }

    private async Task CloseLightboxAsync(int lastId)
    {
        _open = null;
        // Tag edits in the viewer can change what a tag filter matches.
        if (_staleAfterLightbox || TagFilterCount > 0)
        {
            _staleAfterLightbox = false;
            await RefreshAsync(keepPosition: true);
        }
        if (_view is not null) await _view.InvokeVoidAsync("reveal", lastId);
    }

    [JSInvokable]
    public Task OpenMedia(int id)
    {
        _open = id;
        _present = _autoplay = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>Opens the viewer at <paramref name="id"/> in presentation mode; arrows move through the current order.</summary>
    [JSInvokable]
    public Task PresentMedia(int id)
    {
        _open = id;
        _present = true;
        _autoplay = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    // Presentation with autoplay, through the current filters and sort (Random makes it a shuffled slideshow).
    private void StartSlideshow()
    {
        _open = _ids[0];
        _present = _autoplay = true;
    }

    [JSInvokable]
    public void NewWindow() => Window.OpenNewWindow?.Invoke();

    [JSInvokable]
    public void OnViewport(int[] ids) => Gallery.SetViewport(ids);

    [JSInvokable]
    public Task<string[]> GetFileNames(int[] ids) => Gallery.GetFileNamesAsync(ids);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Gallery.ProgressChanged -= OnProgress;
        Gallery.GalleryChanged -= OnGalleryChanged;
        Gallery.ScanCompleted -= OnScanCompleted;
        Gallery.BusyChanged -= OnBusyChanged;
        Gallery.WatchStatusChanged -= OnWatchStatusChanged;
        _searchDelay?.Cancel();
        _failureDelay?.Cancel();
        try
        {
            if (_view is not null)
            {
                await _view.InvokeVoidAsync("dispose");
                await _view.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        _self?.Dispose();
    }
}
